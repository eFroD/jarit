FROM ghcr.io/astral-sh/uv:0.11.3 AS uv

FROM python:3.13-slim

WORKDIR /app

RUN apt-get update && apt-get install -y \
    gcc \
    ffmpeg \
    wget \
    && rm -rf /var/lib/apt/lists/*

COPY --from=uv /uv /uvx /bin/

# The environment is complete after the build: `uv run` must not sync (or reach
# the network) when the container starts.
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_NO_SYNC=1 \
    PATH="/app/.venv/bin:$PATH"

COPY pyproject.toml uv.lock ./

# yt-dlp has to follow changes on the video platforms, so every build takes the
# newest release; all other packages stay as locked. A new YTDLP_REFRESH value
# (the scheduled rebuild passes the run id) skips the build cache for this step.
ARG YTDLP_REFRESH=local
RUN --mount=type=cache,target=/root/.cache/uv \
    echo "yt-dlp refresh: ${YTDLP_REFRESH}" \
    && uv lock --upgrade-package yt-dlp \
    && uv sync --locked --no-dev --no-install-project \
    && echo "yt-dlp $(yt-dlp --version)"

COPY . .

EXPOSE 8000

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
